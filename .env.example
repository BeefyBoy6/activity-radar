# Copy to .env and fill in what you use. Everything is optional —
# the app runs fine with no .env at all (notifications just stay off).

# --- General ---
AT_DB_PATH=data/tracker.db
AT_ZIP=55113
AT_RADIUS_MINUTES=15
AT_TIMEZONE=America/Chicago
AT_SCRAPE_HOUR=6            # daily scrape at 6am local

# --- Email notifications (SMTP) ---
AT_SMTP_HOST=
AT_SMTP_PORT=587
AT_SMTP_USER=
AT_SMTP_PASSWORD=
AT_EMAIL_FROM=
AT_EMAIL_TO=ryan.d.whitesparks@gmail.com

# --- ntfy push notifications (https://ntfy.sh) ---
# Pick a private random topic name and subscribe to it in the ntfy app.
AT_NTFY_TOPIC=

# --- Optional LLM extraction for messy/custom sites ---
# Provider: "anthropic" or "gemini". Leave blank to disable.
AT_LLM_PROVIDER=
AT_LLM_API_KEY=
AT_LLM_MODEL=
